{
  "name": "workflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "build:core": "vp run @bubblesjs/workflow-vue-core#build",
    "build:history": "vp run @bubblesjs/workflow-vue-history#build",
    "build:vue": "pnpm --filter vue-playground... run build",
    "changeset": "changeset",
    "check": "vp run quality",
    "ci": "pnpm check && pnpm build && pnpm verify:packages",
    "dev": "vp run vue-playground#dev",
    "dev:core": "vp run @bubblesjs/workflow-vue-core#dev",
    "dev:history": "vp run @bubblesjs/workflow-vue-history#dev",
    "dev:vue": "vp run vue-playground#dev",
    "docs:build": "vp run docs#build",
    "docs:dev": "vp run docs#dev",
    "docs:preview": "vp run docs#preview",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "hooks:install": "vp config --hooks-dir .vite-hooks --no-agent",
    "lint": "pnpm lint:ox && pnpm lint:vue",
    "lint:fix": "pnpm lint:ox:fix && pnpm lint:vue:fix",
    "lint:ox": "vp lint .",
    "lint:ox:fix": "vp lint . --fix",
    "lint:vue": "eslint . --max-warnings=0",
    "lint:vue:fix": "eslint . --fix --max-warnings=0",
    "prepare": "pnpm hooks:install",
    "preview": "vp run vue-playground#preview",
    "ready": "pnpm run ci",
    "release": "pnpm ready && changeset publish",
    "test": "vp run -r test",
    "typecheck": "tsc -p tsconfig.json --noEmit && vp run -r typecheck",
    "verify:packages": "vp run -r verify:package",
    "version-packages": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile && pnpm format"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
